# =============================================================================
# Rental Contract Revenue Intelligence System — Environment Variables
# =============================================================================
# Copy this file: cp .env.example .env.local
# Never commit .env.local to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL via Docker)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://dev:dev@localhost:5433/rental_dev

# -----------------------------------------------------------------------------
# LINE Messaging API
# Get these from LINE Developers Console: https://developers.line.biz/
# -----------------------------------------------------------------------------
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Comma-separated LINE user IDs of property owners (authorized users)
# Get your LINE user ID from LINE Developers Console > Your profile
OWNER_LINE_IDS=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Secret for signing contract signing JWT tokens (generate: openssl rand -hex 32)
SIGNING_SECRET=

# Secret for authenticating cron job HTTP requests (generate: openssl rand -hex 32)
CRON_SECRET=

# Web dashboard admin credentials
ADMIN_USERNAME=admin
# Password hash: generate with → node -e "require('crypto').createHash('sha256').update('your_password').digest('hex') |> console.log"
# Or run: openssl passwd -6 your_password
ADMIN_PASSWORD_HASH=

# Session secret for signing session cookies (generate: openssl rand -hex 32)
SESSION_SECRET=

# -----------------------------------------------------------------------------
# AI (optional — system works without this using template fallbacks)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# -----------------------------------------------------------------------------
# Owner Info (used in generated PDF contracts)
# -----------------------------------------------------------------------------
OWNER_NAME=ชื่อเจ้าของ
OWNER_ADDRESS=กรุงเทพมหานคร
OWNER_ID_CARD=X-XXXX-XXXXX-XX-X
